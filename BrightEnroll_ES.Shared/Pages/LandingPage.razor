@page "/"
@inject NavigationManager Navigation
@layout EmptyLayout

<div class="landing-container">
    <div class="landing-card-center">
     <div class="text-center">
 <img src="_content/BrightEnroll_ES.Shared/images/brighthenlogo.png" width="280" alt="BrightEnroll Logo" class="mb-3" />

        </div>

        <button class="btn btn-primary w-100 mb-3 landing-btn" @onclick="GoToLogin">
LOG IN
   </button>

    <div class="text-center">
 <a href="/student-register" class="landing-link" @onclick="GoToRegister" @onclick:preventDefault>
  Student Registration
  </a>
  </div>
 </div>
</div>

@code {
    void GoToLogin()
    {
 Navigation.NavigateTo("/login");
    }

    void GoToRegister()
  {
Navigation.NavigateTo("/student-register");
}
}
