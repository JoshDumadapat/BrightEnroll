@page "/login"
@using System.ComponentModel.DataAnnotations
@inject NavigationManager Navigation
@layout EmptyLayout

<div class="login-page-split">
    <!-- Left Side (Image) -->
  <div class="login-left">
 <img src="_content/BrightEnroll_ES.Shared/images/kid.png" alt="School Child" class="login-left-image" />
    </div>

    <!-- Right Side (Login Form) -->
<div class="login-right">
        <div class="login-card-split">
        <div class="text-center mb-4">
 <img src="_content/BrightEnroll_ES.Shared/images/brighthenlogo.png" width="200" alt="BrightEnroll Logo" />
      </div>

      <h3 class="text-center mt-3">Log in to your account</h3>
<p class="text-center text-muted mb-4">Access your account and start managing student enrollments<br />with ease and confidence.</p>

     @if (!string.IsNullOrEmpty(errorMessage))
  {
   <div class="alert alert-danger" role="alert">
  @errorMessage
  </div>
    }

   <EditForm Model="@loginModel" OnValidSubmit="@LoginUser">
         <DataAnnotationsValidator />

     <div class="form-group mb-3">
 <label for="username" class="form-label">Enter username <span class="text-danger">*</span></label>
        <div class="input-group">
   <span class="input-group-text username-icon-wrapper">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
  <path d="M11 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0z"/>
  <path fill-rule="evenodd" d="M0 8a8 8 0 1 1 16 0A8 8 0 0 1 0 8zm8-7a7 7 0 0 0-5.468 11.37C3.242 11.226 4.805 10 8 10s4.757 1.225 5.468 2.37A7 7 0 0 0 8 1z"/>
</svg>
  </span>
       <InputText id="username" 
        @bind-Value="loginModel.Username" 
      placeholder="Username" 
  class="form-control" 
  disabled="@isLoading"
       autocomplete="username" />
 </div>
<ValidationMessage For="@(() => loginModel.Username)" class="text-danger small" />
  </div>

          <div class="form-group mb-3">
<label for="password" class="form-label">Enter password <span class="text-danger">*</span></label>
     <div class="input-group">
  <span class="input-group-text password-icon-wrapper">
  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
<path d="M5.338 1.59a61.44 61.44 0 0 0-2.837.856.481.481 0 0 0-.328.39c-.554 4.157.726 7.19 2.253 9.188a10.725 10.725 0 0 0 2.287 2.233c.346.244.652.42.893.533.12.057.218.095.293.118a.55.55 0 0 0 .101.025.615.615 0 0 0 .1-.025c.076-.023.174-.061.294-.118.24-.113.547-.29.893-.533a10.726 10.726 0 0 0 2.287-2.233c1.527-1.997 2.807-5.031 2.253-9.188a.48.48 0 0 0-.328-.39c-.651-.213-1.75-.56-2.837-.855C9.552 1.29 8.531 1.067 8 1.067c-.53 0-1.552.223-2.662.524zM5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.775 11.775 0 0 1-2.517 2.453 7.159 7.159 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7.158 7.158 0 0 1-1.048-.625 11.777 11.777 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 62.456 62.456 0 0 1 5.072.56z"/>
<path d="M9.5 6.5a1.5 1.5 0 0 1-1 1.415l.385 1.99a.5.5 0 0 1-.491.595h-.788a.5.5 0 0 1-.49-.595l.384-1.99a1.5 1.5 0 1 1 2-1.415z"/>
</svg>
     </span>
      <InputText id="password" 
     type="password"
    @bind-Value="loginModel.Password" 
   placeholder="Password" 
   class="form-control" 
disabled="@isLoading"
 autocomplete="current-password" />
    </div>
    <ValidationMessage For="@(() => loginModel.Password)" class="text-danger small" />
</div>

        <div class="form-check mb-3">
<InputCheckbox id="rememberMe" 
   @bind-Value="loginModel.RememberMe" 
     class="form-check-input" 
   disabled="@isLoading" />
  <label class="form-check-label" for="rememberMe">
      Remember me
</label>
  </div>

 <button type="submit" class="btn btn-primary w-100 py-2 mb-3" disabled="@isLoading" style="border-radius: 25px;">
   @if (isLoading)
         {
         <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
   <span>LOGGING IN...</span>
      }
   else
 {
       <span>LOG IN</span>
            }
  </button>
</EditForm>

    <div class="text-center">
             <a href="/student-register" class="text-decoration-underline" style="color: #6c757d; cursor: pointer;">Student Registration</a>
    </div>
        </div>
</div>
</div>

@code {
    private LoginModel loginModel = new();
    private bool isLoading = false;
    private string errorMessage = "";

    async Task LoginUser()
    {
  isLoading = true;
     errorMessage = "";

   try
        {
         // TODO: call API login endpoint
 await Task.Delay(1000); // Simulate API call 
        // Temporary: Navigate to dashboard for demo
       Navigation.NavigateTo("/dashboard");
        }
    catch (Exception ex)
    {
        errorMessage = $"An error occurred: {ex.Message}";
        }
        finally
        {
  isLoading = false;
  }
    }

    public class LoginModel
    {
        [Required(ErrorMessage = "Username is required")]
        [MinLength(3, ErrorMessage = "Username must be at least 3 characters")]
        public string Username { get; set; } = "";

        [Required(ErrorMessage = "Password is required")]
        [MinLength(6, ErrorMessage = "Password must be at least 6 characters")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; } = false;
    }
}
